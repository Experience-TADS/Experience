# Copie este arquivo para .env e preencha com seus valores
# cp .env.example .env

# ─── PostgreSQL (RDS) ───────────────────────────────────────
POSTGRES_HOST=experience-db.xxxx.us-east-1.rds.amazonaws.com
POSTGRES_DB=db_experience
POSTGRES_USER=postgres
POSTGRES_PASSWORD=SuaSenhaForteAqui

# ─── JWT ───────────────────────────────────────────────────
# Gere com: openssl rand -base64 32
JWT_SECRET=

# ─── InfluxDB ──────────────────────────────────────────────
INFLUX_PASSWORD=admin123
